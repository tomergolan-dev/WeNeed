# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (pooled). Locally, point it at the Neon
# "dev" branch, never at production.
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=

# Signs the session cookie and hashes sign-in codes. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Sign in with Google (Google Cloud Console > APIs & Services > Credentials > OAuth client, type "Web application").
# Redirect URI: <site address>/api/auth/google/callback. Without these, the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in codes by email (Resend). Without the key, development prints the code to the server log.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. WeNeed <noreply@tomergolan.dev>
EMAIL_FROM=

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random string you choose; must match the "Verify token" set in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=
# Set to 1 locally to log bot replies instead of sending them
WHATSAPP_DRY_RUN=

# Claude API
ANTHROPIC_API_KEY=

# Public base URL of the web app, used in the link the paused bot sends
APP_URL=http://localhost:3000
