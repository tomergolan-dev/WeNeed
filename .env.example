# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (pooled)
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random string you choose; must match the "Verify token" set in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Public base URL of the web app, used in links the bot sends
APP_URL=http://localhost:3000
